import /init.recovery.qcom_decrypt.rc

on init
    # Match the stock X806B recovery: turn on the panel before UI starts.
    write /sys/class/backlight/panel0-backlight/brightness 200
    setprop sys.usb.controller a600000.dwc3
    setprop sys.usb.configfs 1

on property:ro.boot.usbcontroller=*
#    setprop sys.usb.controller ${ro.boot.usbcontroller}
    wait /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode
    write /sys/bus/platform/devices/${ro.boot.usb.dwc3_msm:-a600000.ssusb}/mode peripheral
    wait /sys/class/udc/${ro.boot.usbcontroller} 1

    # unlink /efs > /mnt/vendor/efs
    rm /efs
    mkdir /efs
    mkdir /sec_efs

    # to cut charging battery path
    write /sys/class/power_supply/battery/siop_level 0

on fs
    wait /dev/block/platform/soc/${ro.boot.bootdevice}
    symlink /dev/block/platform/soc/${ro.boot.bootdevice} /dev/block/bootdevice

    export ANDROID_ROOT /system_root

    # Mount modem firmware so the skeymint TrustZone app can be located early.
    mkdir /vendor/firmware_mnt 0771 root root
    mount vfat /dev/block/bootdevice/by-name/apnhlos /vendor/firmware_mnt ro

    # Mount EFS read-write so Samsung keymint can create gakkeybox on first use.
    mkdir /mnt/vendor/efs 0771 root root
    mount ext4 /dev/block/bootdevice/by-name/efs /mnt/vendor/efs rw

on boot
    setprop ro.boot.vbmeta.avb_version 1.2
    setprop ro.boot.avb_version 1.2
    setprop ro.hardware.gatekeeper mdfpp

    start keymint-samsung
    start gatekeeper-samsung
    setprop vendor.sys.listeners.registered true
    setprop sys.listeners.registered true

# Samsung KeyMint AIDL service
service keymint-samsung /vendor/bin/hw/android.hardware.security.keymint-service
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/system/lib64
    disabled
    oneshot
    seclabel u:r:recovery:s0

# Samsung Gatekeeper HIDL service
service gatekeeper-samsung /vendor/bin/hw/android.hardware.gatekeeper@1.0-service
    user root
    group root
    setenv LD_LIBRARY_PATH /vendor/lib64:/vendor/lib64/hw:/system/lib64
    disabled
    seclabel u:r:recovery:s0

# Samsung Hermes weaver daemon
service hermesd /vendor/bin/hermesd /data/vendor/gatekeeper
    user root
    group root system
    socket hermes_secnvm stream 660 system system
    setenv LD_LIBRARY_PATH /vendor/lib64/hermes:/vendor/lib64:/system/lib64
    disabled
    seclabel u:r:recovery:s0
